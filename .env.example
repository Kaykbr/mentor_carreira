# Copie este arquivo para .env e preencha os valores.
# Veja docs/INSTALACAO.md (seção 4) para a descrição de cada variável.

# Chave da API Anthropic — obrigatória para uso real (não é necessária para rodar os testes).
# Obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY=

# URL de conexão do banco (SQLAlchemy). Padrão: SQLite local.
DATABASE_URL=sqlite:///./mentor.db

# Modelo Claude utilizado por padrão (triagem, e fallback das duas variáveis abaixo).
CLAUDE_MODEL=claude-haiku-4-5

# Modelo para extrair o perfil ao final da triagem (análise determinística,
# temperature=0). Se vazio, usa CLAUDE_MODEL. Pode ser um modelo mais barato/rápido,
# já que a tarefa é estruturada e não exige tom conversacional.
# Ex.: CLAUDE_MODEL_ANALISE=claude-haiku-4-5
CLAUDE_MODEL_ANALISE=

# Modelo para gerar o PDI e o currículo (textos mais completos e elaborados).
# Se vazio, usa CLAUDE_MODEL.
CLAUDE_MODEL_GERACAO=

# Ambiente: "development" ou "production".
# Em "production", a SECRET_KEY padrão é recusada e o cookie passa a exigir HTTPS.
APP_ENV=development

# Assina o cookie de sessão (login). TROQUE por um valor forte em produção:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-change-me

# Duração da sessão, em segundos (padrão: 28800 = 8 horas).
SESSION_MAX_AGE=28800

# Cookie de sessão só por HTTPS (flag Secure). Deixe false em dev (HTTP);
# em production vira true automaticamente, salvo se definido aqui.
SESSION_HTTPS_ONLY=false

# E-mails (separados por vírgula) com acesso ao painel de administração (/admin).
# Quem fizer login com um desses e-mails é tratado como administrador.
# Ex.: ADMIN_EMAILS=coordenacao@faculdade.edu,prof@faculdade.edu
ADMIN_EMAILS=

# Código de convite exigido no cadastro. Vazio (padrão) = cadastro aberto.
# Defina em produção com link público, para que só quem recebeu o código crie conta
# (evita que estranhos consumam a cota da API). Ex.: INVITE_CODE=tcc-ifce-2026
INVITE_CODE=

# Limita requisições por IP (cadastro, login, triagem). Deixe true em produção.
# Use false apenas em testes automatizados ou desenvolvimento local.
RATE_LIMIT_ATIVO=true
