%% Diagrama de Sequencia - Triagem (chat) e geracao do Perfil estruturado
sequenceDiagram
    autonumber
    actor Aluno
    participant Rt as triage.py
    participant Guard as verificar_proprio_aluno
    participant PS as profile_service
    participant CC as claude_client
    participant API as Anthropic API
    participant DB as SQLite

    rect rgb(240, 249, 255)
    note over Aluno,DB: Enviar mensagem (POST /triage/{id}/mensagens)
    Aluno->>Rt: mensagem
    Rt->>Guard: sessao + dono do {id}?
    Guard-->>Rt: ok (senao 401/403)
    Rt->>PS: enviar_mensagem_triagem(id, texto)
    PS->>DB: INSERT triage_messages (role=user)
    PS->>PS: obter_historico(id)
    PS->>CC: conversar_triagem(historico)
    CC->>API: messages.create (com retry/tenacity)
    API-->>CC: resposta do mentor
    CC-->>PS: texto
    PS->>DB: INSERT triage_messages (role=assistant)
    PS-->>Rt: resposta
    Rt-->>Aluno: 200 { resposta }
    end

    rect rgb(243, 244, 246)
    note over Aluno,DB: Finalizar triagem (POST /triage/{id}/finalizar)
    Aluno->>Rt: finalizar
    Rt->>Guard: sessao + dono do {id}?
    Guard-->>Rt: ok
    Rt->>PS: finalizar_triagem(id)
    PS->>PS: obter_historico(id)
    alt historico vazio
        PS-->>Rt: ValueError -> 400
    else tem historico
        PS->>CC: gerar_perfil_estruturado(historico)
        CC->>API: messages.create (tool_use forcado: salvar_perfil)
        API-->>CC: bloco tool_use (JSON do perfil)
        CC-->>PS: profile_json
        PS->>DB: upsert student_profiles
        PS-->>Rt: StudentProfile
        Rt-->>Aluno: 200 (perfil)
    end
    end
