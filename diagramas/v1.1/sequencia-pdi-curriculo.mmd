%% Diagrama de Sequencia - Geracao do PDI e do Curriculo (a partir do perfil)
sequenceDiagram
    autonumber
    actor Aluno
    participant Rt as pdi.py / curriculum.py
    participant Guard as verificar_proprio_aluno
    participant PdiS as pdi_service
    participant CvS as curriculum_service
    participant PS as profile_service
    participant CC as claude_client
    participant API as Anthropic API
    participant DB as SQLite

    rect rgb(240, 249, 255)
    note over Aluno,DB: Gerar PDI (POST /pdi/{id}/gerar)
    Aluno->>Rt: gerar PDI
    Rt->>Guard: sessao + dono do {id}?
    Guard-->>Rt: ok (senao 401/403)
    Rt->>PdiS: gerar_pdi(id)
    PdiS->>PS: obter_perfil(id)
    PS->>DB: SELECT student_profiles
    alt sem perfil
        PdiS-->>Rt: ValueError -> 400
    else tem perfil
        PdiS->>CC: gerar_pdi(profile_json)
        CC->>API: messages.create (tool_use forcado: salvar_pdi)
        API-->>CC: bloco tool_use (JSON do PDI)
        CC-->>PdiS: pdi_json
        PdiS->>DB: upsert pdis
        PdiS-->>Rt: PDI
        Rt-->>Aluno: 200 (PDI)
    end
    end

    rect rgb(243, 244, 246)
    note over Aluno,DB: Gerar curriculo (POST /curriculum/{id}/gerar)
    Aluno->>Rt: gerar curriculo
    Rt->>Guard: sessao + dono do {id}?
    Guard-->>Rt: ok
    Rt->>CvS: gerar_curriculo(id)
    CvS->>PS: obter_perfil(id)
    PS->>DB: SELECT student_profiles
    CvS->>PdiS: obter_pdi(id) (opcional)
    PdiS->>DB: SELECT pdis
    alt sem perfil
        CvS-->>Rt: ValueError -> 400
    else tem perfil
        CvS->>CC: gerar_curriculo(profile_json, pdi_json?)
        CC->>API: messages.create (texto livre, sem tool_use)
        API-->>CC: texto do curriculo (ATS)
        CC-->>CvS: curriculum_text
        CvS->>DB: upsert curriculums
        CvS-->>Rt: Curriculum
        Rt-->>Aluno: 200 (curriculo)
    end
    end
